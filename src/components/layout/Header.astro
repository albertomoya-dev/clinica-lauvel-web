---
import Logo from '../ui/Logo.astro';
import Icon from '../ui/Icon.astro';
import MobileMenu from './MobileMenu.astro';
import { mainNavLeft, mainNavRight, servicesNav } from '../../data/navigation';
import { withBase } from '../../utils/url';

interface Props {
  solid?: boolean;
}

const { solid = false } = Astro.props;
const path = Astro.url.pathname;
const homeHref = withBase('/');

const isActive = (href: string) => (href === homeHref ? path === homeHref : path.startsWith(href));
const servicesActive = servicesNav.some((s) => isActive(s.href));
---

<header id="site-header" data-solid={solid ? 'true' : undefined}>
  <div class="container-site">
    <nav class="grid h-24 grid-cols-[1fr_auto_1fr] items-center gap-6 lg:h-28 lg:gap-10" aria-label="Navegación principal">
      <ul class="hidden items-center justify-start gap-6 justify-self-end lg:flex">
        {
          mainNavLeft.map((item) => (
            <li>
              <a href={item.href} class="nav-link" data-active={isActive(item.href) ? 'true' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <button
        type="button"
        id="menu-open"
        class="nav-fg inline-flex size-11 items-center justify-center justify-self-start lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Abrir menú"
      >
        <Icon name="menu" class="size-6" />
      </button>

      <div class="logo-wrapper relative aspect-square h-16 justify-self-center lg:h-20">
        <Logo type="icon" class="header-logo absolute inset-0 h-full w-auto" />
        <Logo type="icon" variant="green" class="header-logo-green absolute inset-0 h-full w-auto opacity-0" />
      </div>

      <ul class="hidden items-center justify-start gap-6 justify-self-start lg:flex">
        <li class="relative" data-dropdown>
          <button
            type="button"
            class="nav-link inline-flex items-center gap-1.5"
            data-active={servicesActive ? 'true' : undefined}
            aria-expanded="false"
            aria-haspopup="true"
            data-dropdown-trigger
          >
            Servicios
            <Icon name="chevron-down" class="size-4 transition-transform duration-300" />
          </button>
          <div class="dropdown-panel" data-dropdown-panel>
            <ul class="flex flex-col py-3">
              {
                servicesNav.map((item) => (
                  <li>
                    <a href={item.href} class="dropdown-link" data-active={isActive(item.href) ? 'true' : undefined}>
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </li>
        {
          mainNavRight.map((item) => (
            <li>
              <a href={item.href} class="nav-link" data-active={isActive(item.href) ? 'true' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <span class="hidden lg:hidden" aria-hidden="true"></span>
      <span class="justify-self-end lg:hidden" aria-hidden="true"></span>
    </nav>
  </div>

  <MobileMenu />
</header>

<style>
  #site-header {
    --header-fg: #fff;
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 60;
    color: var(--header-fg);
    transition:
      background-color 0.35s ease,
      box-shadow 0.35s ease,
      transform 0.35s ease;
  }

  @media (max-width: 1023px) {
    #site-header[data-hidden] {
      transform: translateY(-100%);
    }
  }

  #site-header[data-scrolled],
  #site-header[data-solid] {
    --header-fg: var(--color-ink);
    background: #fff;
    box-shadow: 0 6px 30px rgb(22 22 21 / 0.08);
  }

  .nav-fg {
    color: var(--header-fg);
  }

  :global(.header-logo),
  :global(.header-logo-green) {
    transition: opacity 0.35s ease;
  }

  :global(.header-logo img) {
    filter: brightness(0) invert(1);
  }

  #site-header[data-scrolled] :global(.header-logo),
  #site-header[data-solid] :global(.header-logo) {
    opacity: 0;
  }

  #site-header[data-scrolled] :global(.header-logo-green),
  #site-header[data-solid] :global(.header-logo-green) {
    opacity: 1;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding-block: 0.5rem;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--header-fg);
    background: none;
    cursor: pointer;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 2px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
  }

  .nav-link:hover::after,
  .nav-link[data-active]::after {
    transform: scaleX(1);
  }

  .dropdown-panel {
    position: absolute;
    top: calc(100% + 0.75rem);
    left: 0;
    min-width: 17rem;
    border-radius: 0.75rem;
    background: var(--color-ink);
    box-shadow: 0 20px 50px rgb(0 0 0 / 0.25);
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition:
      opacity 0.25s ease,
      transform 0.25s ease,
      visibility 0.25s;
  }

  [data-dropdown]:hover .dropdown-panel,
  [data-dropdown]:focus-within .dropdown-panel,
  .dropdown-panel[data-open] {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .dropdown-link {
    display: block;
    padding: 0.85rem 1.5rem;
    font-size: 0.95rem;
    color: #fff;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .dropdown-link:hover,
  .dropdown-link[data-active] {
    background: rgb(255 255 255 / 0.06);
    color: var(--color-gold);
  }
</style>

<script>
  declare global {
    interface Window {
      __lauvelHeaderScrollBound?: boolean;
    }
  }

  let lastScrollY = window.scrollY;

  const updateHeader = () => {
    const header = document.getElementById('site-header');
    const menu = document.getElementById('mobile-menu');
    if (!header) return;

    const scrollY = window.scrollY;
    if (scrollY > 40) header.setAttribute('data-scrolled', '');
    else header.removeAttribute('data-scrolled');

    if (window.matchMedia('(max-width: 1023px)').matches) {
      const menuOpen = menu && !menu.hasAttribute('hidden');
      if (!menuOpen && scrollY > 80 && scrollY > lastScrollY) {
        header.setAttribute('data-hidden', '');
      } else {
        header.removeAttribute('data-hidden');
      }
    } else {
      header.removeAttribute('data-hidden');
    }

    lastScrollY = scrollY;
  };

  const initHeader = () => {
    const dropdown = document.querySelector('[data-dropdown]');
    const trigger = dropdown?.querySelector('[data-dropdown-trigger]') as HTMLButtonElement | null;
    const panel = dropdown?.querySelector('[data-dropdown-panel]');

    trigger?.addEventListener('click', () => {
      const open = panel?.hasAttribute('data-open');
      if (open) {
        panel?.removeAttribute('data-open');
        trigger.setAttribute('aria-expanded', 'false');
      } else {
        panel?.setAttribute('data-open', '');
        trigger.setAttribute('aria-expanded', 'true');
      }
    });

    updateHeader();
  };

  if (!window.__lauvelHeaderScrollBound) {
    window.__lauvelHeaderScrollBound = true;
    window.addEventListener('scroll', updateHeader, { passive: true });
    window.addEventListener('resize', updateHeader, { passive: true });
    document.addEventListener('lauvel:menu-toggle', updateHeader);
  }

  document.addEventListener('click', (e) => {
    const dropdown = document.querySelector('[data-dropdown]');
    if (dropdown && !dropdown.contains(e.target as Node)) {
      document.querySelector('[data-dropdown-panel]')?.removeAttribute('data-open');
      document.querySelector('[data-dropdown-trigger]')?.setAttribute('aria-expanded', 'false');
    }
  });

  initHeader();
  document.addEventListener('astro:page-load', initHeader);
</script>
