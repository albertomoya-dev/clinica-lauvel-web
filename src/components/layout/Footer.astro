---
import Logo from '../ui/Logo.astro';
import Icon from '../ui/Icon.astro';
import { mainNavLeft, mainNavRight, servicesNav, legalNav } from '../../data/navigation';
import { site, isPending } from '../../data/site';
import { withBase } from '../../utils/url';

const path = Astro.url.pathname;
const homeHref = withBase('/');
const isActive = (href: string) => (href === homeHref ? path === homeHref : path.startsWith(href));
---

<footer class="bg-ink text-white/75">
  <div class="container-site flex flex-col items-center gap-9 py-16 text-center">
    <Logo type="main" class="footer-logo h-40 w-auto" />

    {
      site.languageSelector && (
        <select class="rounded-md border border-white/20 bg-white px-4 py-2 text-sm text-ink" aria-label="Selector de idioma">
          <option value="es">Español</option>
          <option value="en">English</option>
        </select>
      )
    }

    <nav aria-label="Menú secundario">
      <ul class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-[0.95rem] font-medium">
        {
          mainNavLeft.map((item) => (
            <li>
              <a href={item.href} class="transition-colors hover:text-gold" data-active={isActive(item.href) ? 'true' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="relative">
          <details class="group" id="footer-services">
            <summary
              class="flex cursor-pointer list-none items-center gap-1.5 transition-colors hover:text-gold [&::-webkit-details-marker]:hidden"
              aria-label="Mostrar u ocultar servicios"
              aria-controls="footer-services-list"
            >
              Servicios
              <Icon name="chevron-down" class="size-4 transition-transform duration-300 group-open:rotate-180" aria-hidden="true" />
            </summary>
            <ul
              id="footer-services-list"
              class="absolute bottom-full left-1/2 mb-3 flex w-56 -translate-x-1/2 flex-col rounded-xl bg-white/5 py-2 text-left backdrop-blur"
            >
              {
                servicesNav.map((item) => (
                  <li>
                    <a href={item.href} class="block px-5 py-2.5 text-sm transition-colors hover:text-gold">
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </details>
        </li>
        {
          mainNavRight.map((item) => (
            <li>
              <a href={item.href} class="transition-colors hover:text-gold" data-active={isActive(item.href) ? 'true' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {!isPending(site.instagramUrl) && (
      <a href={site.instagramUrl} target="_blank" rel="noopener noreferrer" aria-label="Instagram de Clínica LAUVEL" class="text-white transition-colors hover:text-gold">
        <Icon name="instagram" class="size-6" />
      </a>
    )}

    {
      (!isPending(site.address) || !isPending(site.phone) || !isPending(site.email)) && (
        <address class="flex flex-col items-center gap-1.5 text-sm not-italic text-white/55">
          {!isPending(site.address) && (
            <a
              href={site.mapUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="transition-colors hover:text-gold"
            >
              {site.address}
            </a>
          )}
          <span>
            {!isPending(site.phone) && <>Tel. {site.phone}</>}
            {!isPending(site.phone) && !isPending(site.email) && <> · </>}
            {!isPending(site.email) && <a href={`mailto:${site.email}`} class="transition-colors hover:text-gold">{site.email}</a>}
          </span>
        </address>
      )
    }

    {
      site.fundingLogos && (
        <div class="flex flex-col items-center gap-3">
          <p class="max-w-xl text-[0.65rem] tracking-wide text-white/40 uppercase">
            Programa Kit Digital cofinanciado por los fondos Next Generation (EU) del Mecanismo de Recuperación y Resiliencia
          </p>
        </div>
      )
    }

    <p class="border-t border-white/10 pt-7 text-[0.82rem] text-white/50">
      {site.name}©.
      {
        legalNav.map((item, i) => (
          <>
            <a href={item.href} class="transition-colors hover:text-gold">{item.label}</a>
            {i < legalNav.length - 1 && <span aria-hidden="true"> · </span>}
          </>
        ))
      }
    </p>
  </div>
</footer>

<style>
  footer a[data-active] {
    color: var(--color-gold);
  }

  :global(.footer-logo img) {
    filter: brightness(0) invert(1);
  }

  footer details > ul {
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    pointer-events: none;
    transition:
      opacity 0.25s ease,
      transform 0.25s ease,
      visibility 0.25s;
  }

  footer details[open] > ul {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }
</style>

<script>
  const details = document.getElementById('footer-services') as HTMLDetailsElement | null;
  if (details) {
    const close = () => {
      details.removeAttribute('open');
    };

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && details.open) {
        e.preventDefault();
        close();
      }
    });

    document.addEventListener('click', (e) => {
      if (!details.open) return;
      const target = e.target as Node;
      if (!details.contains(target)) {
        close();
      }
    });
  }
</script>
