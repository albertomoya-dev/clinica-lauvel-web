---
import { site, isPending } from '../../data/site';
import { withBase } from '../../utils/url';

const data: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'MedicalClinic',
  name: site.name,
  url: new URL(withBase('/'), site.domain).href,
  description:
    'Centro multidisciplinar de logopedia, psicología, pedagogía y fisioterapia para bebés, niños, adolescentes y adultos.',
  medicalSpecialty: ['Logopedia', 'Psicología', 'Pedagogía', 'Fisioterapia'],
};

if (!isPending(site.address)) {
  data.address = {
    '@type': 'PostalAddress',
    streetAddress: site.address,
    addressLocality: isPending(site.city) ? undefined : site.city,
    addressCountry: 'ES',
  };
}
if (!isPending(site.phone)) data.telephone = site.phone;
if (!isPending(site.email)) data.email = site.email;
if (!isPending(site.instagramUrl)) data.sameAs = [site.instagramUrl];
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />
