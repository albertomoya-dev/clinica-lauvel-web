---
import { withBase } from '../../utils/url';

const cookiesHref = withBase('/politica-de-cookies/');
---

<div
  id="cookie-banner"
  class="fixed inset-x-0 bottom-0 z-[80] border-t border-ink/10 bg-white shadow-[0_-10px_40px_rgb(22_22_21/0.12)]"
  role="dialog"
  aria-live="polite"
  aria-label="Aviso de cookies"
  hidden
>
  <div class="container-site flex flex-col gap-5 py-6 lg:flex-row lg:items-center lg:justify-between">
    <p class="max-w-3xl text-sm text-body">
      En <strong class="font-medium text-ink">Clínica LAUVEL</strong> utilizamos únicamente cookies técnicas y
      almacenamiento local necesarios para el correcto funcionamiento del sitio web. No utilizamos cookies de analítica
      ni de publicidad. Más información en nuestra
      <a href={cookiesHref} class="font-medium text-accent underline underline-offset-2">Política de cookies</a>.
    </p>
    <div class="flex flex-wrap items-center gap-3">
      <button
        type="button"
        id="cookie-accept"
        class="rounded-md bg-ink px-6 py-2.5 text-sm font-medium text-white transition-colors hover:bg-accent"
      >
        Aceptar
      </button>
      <button
        type="button"
        id="cookie-close"
        class="rounded-md border border-ink/25 px-6 py-2.5 text-sm font-medium text-ink transition-colors hover:border-accent hover:text-accent"
      >
        Cerrar
      </button>
    </div>
  </div>
</div>

<script>
  const storageKey = 'lauvel-cookie-consent';
  const banner = document.getElementById('cookie-banner');

  const hideBanner = () => banner?.setAttribute('hidden', '');

  const hasConsent = () => {
    try {
      return localStorage.getItem(storageKey) === 'accepted';
    } catch {
      return false;
    }
  };

  const accept = () => {
    try {
      localStorage.setItem(storageKey, 'accepted');
    } catch {
      /* noop */
    }
    hideBanner();
  };

  if (!hasConsent()) {
    banner?.removeAttribute('hidden');
  }

  document.getElementById('cookie-accept')?.addEventListener('click', accept);
  document.getElementById('cookie-close')?.addEventListener('click', hideBanner);
</script>
