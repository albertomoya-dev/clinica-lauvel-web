---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow?: string;
  title: string;
  image: ImageMetadata;
  imageAlt: string;
  imagePosition?: 'left' | 'right';
  smallImage?: ImageMetadata;
  smallImageAlt?: string;
  cta?: { label: string; href: string };
  soft?: boolean;
}

const {
  eyebrow,
  title,
  image,
  imageAlt,
  imagePosition = 'right',
  smallImage,
  smallImageAlt = '',
  cta,
  soft = false,
} = Astro.props;
---

<section class:list={['py-20 md:py-28', soft && 'bg-softer']}>
  <div class="container-site grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
    <div class:list={['reveal', imagePosition === 'right' ? 'reveal--left' : 'reveal--right', imagePosition === 'left' && 'lg:order-2']}>
      {eyebrow && <p class="eyebrow mb-4">{eyebrow}</p>}
      <h2 class="max-w-xl text-[1.9rem] md:text-[2.6rem]">{title}</h2>
      <div class="mt-6 flex max-w-xl flex-col gap-4 text-[1.02rem] text-body">
        <slot />
      </div>
      {cta && <a href={cta.href} class="btn-primary mt-8">{cta.label}</a>}
      {
        smallImage && (
          <Image
            src={smallImage}
            alt={smallImageAlt}
            widths={[480, 768]}
            sizes="(min-width: 1024px) 33vw, 100vw"
            class="mt-10 aspect-[16/10] w-full max-w-md rounded-2xl object-cover"
            loading="lazy"
            decoding="async"
          />
        )
      }
    </div>
    <div class:list={['reveal', imagePosition === 'right' ? 'reveal--right' : 'reveal--left', imagePosition === 'left' && 'lg:order-1']}>
      <Image
        src={image}
        alt={imageAlt}
        widths={[640, 1024]}
        sizes="(min-width: 1024px) 50vw, 100vw"
        class="aspect-[4/5] w-full rounded-2xl object-cover"
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
</section>
