---
import { site, isPending } from '../../data/site';
import Placeholder from '../ui/Placeholder.astro';

const mapUrl = site.mapUrl;
const query = encodeURIComponent(`${site.address}, ${site.city}, España`);

function extractCoords(url: string): string | null {
  const match = url.match(/!3d(-?\d+\.\d+)!4d(-?\d+\.\d+)/);
  return match ? `${match[1]},${match[2]}` : null;
}

const coords = mapUrl ? extractCoords(mapUrl) : null;
const embedSrc = coords
  ? `https://www.google.com/maps?q=${coords}&output=embed`
  : `https://www.google.com/maps?q=${query}&output=embed`;
const mapLink = mapUrl || `https://www.google.com/maps?q=${query}`;
---

<section class="pb-20 md:pb-28">
  <div class="container-site">
    {
      isPending(site.address) ? (
        <Placeholder label="Mapa de Google — ubicación pendiente de confirmar" class="h-[450px] w-full rounded-2xl" />
      ) : (
        <iframe
          src={embedSrc}
          class="h-[450px] w-full rounded-2xl border-0"
          loading="lazy"
          allowfullscreen
          referrerpolicy="no-referrer-when-downgrade"
          title="Mapa con la ubicación de Clínica LAUVEL"
        ></iframe>
        <p class="mt-3 text-center text-sm text-body">
          <a
            href={mapLink}
            target="_blank"
            rel="noopener noreferrer"
            class="transition-colors hover:text-accent"
          >
            Ver ubicación en Google Maps
          </a>
        </p>
      )
    }
  </div>
</section>
