---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { NeaeBlock } from '../../data/neae';
import { withBase } from '../../utils/url';

interface Props {
  block: NeaeBlock;
  variant?: 'split' | 'simple';
  image?: ImageMetadata;
  imageAlt?: string;
}

const { block, variant = 'simple', image, imageAlt = '' } = Astro.props;
const contactHref = withBase('/contacto/');
---

{
  variant === 'split' ? (
    <section class="py-20 md:py-28">
      <div class="container-site grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
        <div class="reveal reveal--left">
          <h2 class="max-w-xl text-[1.9rem] md:text-[2.6rem]">{block.heading}</h2>
          <div class="mt-6 flex max-w-xl flex-col gap-4 text-[1.02rem] text-body">
            {block.paragraphs.map((p) => (
              <p set:html={p} />
            ))}
            {block.closing && <p class="font-semibold text-ink">{block.closing}</p>}
          </div>
          <a href={contactHref} class="btn-primary mt-8">Contacta</a>
        </div>
        <div class="reveal reveal--right">
          {image && (
            <Image
              src={image}
              alt={imageAlt}
              widths={[640, 1024, 1536]}
              sizes="(min-width: 1024px) 50vw, 100vw"
              class="aspect-[4/3] w-full rounded-2xl object-cover"
              loading="lazy"
              decoding="async"
            />
          )}
        </div>
      </div>
    </section>
  ) : (
    <section class="py-20 md:py-28">
      <div class="container-site">
        <div class="reveal reveal--up max-w-3xl">
          <h2 class="text-[1.9rem] md:text-[2.6rem]">{block.heading}</h2>
          <div class="mt-6 flex flex-col gap-4 text-[1.02rem] text-body">
            {block.paragraphs.map((p) => (
              <p set:html={p} />
            ))}
            {block.closing && <p class="font-semibold text-ink">{block.closing}</p>}
          </div>
        </div>
      </div>
    </section>
  )
}
