---
import { Image } from 'astro:assets';
import SectionHeading from '../ui/SectionHeading.astro';
import { team } from '../../data/team';
import { withBase } from '../../utils/url';

interface Props {
  variant?: 'preview' | 'full';
}

const { variant = 'preview' } = Astro.props;
const quienesHref = withBase('/quienes-somos/');
---

{
  variant === 'preview' ? (
    <section class="py-20 md:py-28">
      <div class="container-site">
        <SectionHeading
          eyebrow="Nuestro equipo"
          title="Especialistas en logopedia, psicología, pedagogía y fisioterapia"
          description="En LAUVEL contamos con un equipo multidisciplinar especializado y en constante formación. Nuestra forma de trabajar se basa en la evidencia científica, la personalización de cada intervención y un trato cercano que genera confianza desde el primer día."
          class="reveal reveal--up"
        />
        <div class="mt-14 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {team.map((member) => (
            <article class="reveal reveal--up rounded-2xl border border-ink/10 bg-soft p-7">
              <Image
                src={member.photo}
                alt={member.photoAlt}
                widths={[400, 640]}
                sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 90vw"
                class="aspect-[4/5] w-full rounded-xl object-cover object-top"
                loading="lazy"
                decoding="async"
              />
              <h3 class="mt-5 font-display text-xl font-medium text-ink">{member.name}</h3>
              <p class="mt-1 text-sm font-medium text-accent">{member.role}</p>
            </article>
          ))}
        </div>
        <div class="reveal reveal--up mt-12 text-center">
          <a href={quienesHref} class="btn-primary">Conócenos</a>
        </div>
      </div>
    </section>
  ) : (
    <section class="py-20 md:py-28">
      <div class="container-site">
        <SectionHeading
          eyebrow="Un equipo que lidera con experiencia y vocación"
          title="Un proyecto que nace de la vocación y del compromiso"
          description="Este equipo forma el núcleo del centro y es la razón por la que tantas familias depositan su confianza en nosotros."
          class="reveal reveal--up"
        />
        <div class="mt-14 grid grid-cols-1 gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
          {team.map((member) => (
            <article class="reveal reveal--up">
              <Image
                src={member.photo}
                alt={member.photoAlt}
                widths={[480, 768]}
                sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                class="aspect-[4/5] w-full rounded-2xl object-cover object-top"
                loading="lazy"
                decoding="async"
              />
              <h3 class="mt-5 font-display text-xl font-medium text-ink">{member.name}</h3>
              <p class="mt-1 text-sm font-medium text-accent">{member.role}</p>
              <p class="mt-4 text-[0.95rem] text-body">
                {member.bio.split('\n').map((line, i, arr) => (
                  <>
                    {line}
                    {i < arr.length - 1 && <br />}
                  </>
                ))}
              </p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )
}
