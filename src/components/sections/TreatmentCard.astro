---
import type { Treatment } from '../../data/treatments';

interface Props {
  treatment: Treatment;
  index: number;
}

const { treatment, index } = Astro.props;
---

<article
  id={treatment.anchor}
  class:list={[
    'reveal reveal--up relative flex flex-col rounded-xl bg-soft p-8',
    treatment.featured && 'ring-2 ring-accent/50',
  ]}
>
  {
    treatment.featured && (
      <span class="absolute top-6 right-6 rounded-full bg-accent px-3 py-1 font-sans text-[0.68rem] font-medium tracking-[0.1em] text-white uppercase">
        Especialidad
      </span>
    )
  }
  <span class="font-display text-[3.4rem] leading-none font-semibold text-card-number" aria-hidden="true">
    {String(index + 1).padStart(2, '0')}
  </span>
  <h3 class="mt-5 max-w-[85%] font-display text-[1.32rem] leading-snug font-medium text-accent">{treatment.title}</h3>
  {treatment.description && <p class="mt-3 text-[0.97rem] text-body">{treatment.description}</p>}
  <ul class="mt-4 flex flex-col gap-2">
    {
      treatment.items.map((item) => (
        <li class="flex items-start gap-2.5 text-[0.93rem] text-body">
          <span class="mt-[0.55rem] size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
          {item}
        </li>
      ))
    }
  </ul>
</article>
