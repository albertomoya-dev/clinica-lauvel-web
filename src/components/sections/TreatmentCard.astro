---
import Icon from '../ui/Icon.astro';
import type { Treatment } from '../../data/treatments';

interface Props {
  treatment: Treatment;
  index: number;
}

const { treatment, index } = Astro.props;
const panelId = treatment.anchor ? `${treatment.anchor}-panel` : `treatment-panel-${index}`;
const cardId = treatment.anchor ? `${treatment.anchor}-card` : `treatment-card-${index}`;
---

<article
  id={cardId}
  class:list={[
    'reveal reveal--up relative flex flex-col rounded-xl bg-soft p-8',
    treatment.featured && 'ring-2 ring-accent/50',
  ]}
  data-treatment-card
>
  <span class="font-display text-[3.4rem] leading-none font-semibold text-card-number" aria-hidden="true">
    {String(index + 1).padStart(2, '0')}
  </span>
  <details class="treatment-details group mt-5">
    <summary
      class="treatment-summary flex items-start justify-between gap-4"
      aria-label={`Ver áreas de ${treatment.title}`}
      aria-controls={panelId}
    >
      <h3 class="max-w-[85%] font-display text-[1.32rem] leading-snug font-medium text-accent">{treatment.title}</h3>
      <span class="inline-flex size-12 shrink-0 items-center justify-center rounded-full border border-accent/60 bg-white/40 text-accent transition-all duration-300 hover:border-accent hover:bg-accent hover:text-white group-open:rotate-180 group-open:bg-accent group-open:text-white">
        <Icon name="chevron-down" class="size-5 transition-transform duration-300 group-open:rotate-180" />
      </span>
    </summary>
    <div
      id={panelId}
      class="treatment-panel grid transition-all duration-300 ease-[cubic-bezier(0.22,1,0.36,1)]"
      role="region"
      aria-label={`Áreas de ${treatment.title}`}
    >
      <div class="treatment-content overflow-hidden">
        {treatment.description && <p class="mt-3 text-[0.97rem] text-body">{treatment.description}</p>}
        <ul class="mt-4 flex flex-col gap-2">
          {
            treatment.items.map((item) => (
              <li class="flex items-start gap-2.5 text-[0.93rem] text-body">
                <span class="mt-[0.55rem] size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </details>
</article>

<style>
  .treatment-summary {
    list-style: none;
    cursor: pointer;
  }
  .treatment-summary::-webkit-details-marker {
    display: none;
  }
  .treatment-panel {
    grid-template-rows: 0fr;
  }
  .treatment-details[open] .treatment-panel {
    grid-template-rows: 1fr;
  }
  .treatment-content {
    min-height: 0;
  }
</style>
