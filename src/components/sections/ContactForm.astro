---
import Icon from '../ui/Icon.astro';
import { site, isPending } from '../../data/site';
import { withBase } from '../../utils/url';

interface Props {
  showNeae?: boolean;
}

const { showNeae = false } = Astro.props;
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
const privacyHref = withBase('/politica-de-privacidad/');
---

<div class="rounded-xl bg-white p-7 shadow-form md:p-9">
  <p class="font-sans text-sm font-medium tracking-[0.14em] text-accent uppercase">Rellena el formulario</p>

  <form
    action="https://api.web3forms.com/submit"
    method="POST"
    class="mt-6 flex flex-col gap-5"
    data-contact-form
    data-has-key={accessKey ? 'true' : 'false'}
  >
    <input type="hidden" name="access_key" value={accessKey} />
    <input type="hidden" name="subject" value="Nuevo mensaje desde la web de Clínica LAUVEL" />
    <input type="hidden" name="from_name" value="Web Clínica LAUVEL" />
    <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

    <div>
      <label for="form-nombre" class="sr-only">Nombre completo</label>
      <input type="text" id="form-nombre" name="nombre" placeholder="Nombre completo" required autocomplete="name" class="field-input" />
    </div>

    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label for="form-email" class="sr-only">Correo electrónico</label>
        <input type="email" id="form-email" name="email" placeholder="Correo electrónico" required autocomplete="email" class="field-input" />
      </div>
      <div>
        <label for="form-telefono" class="sr-only">Teléfono</label>
        <input type="tel" id="form-telefono" name="telefono" placeholder="Teléfono" autocomplete="tel" class="field-input" />
      </div>
    </div>

    <div>
      <label for="form-mensaje" class="sr-only">Mensaje</label>
      <textarea id="form-mensaje" name="mensaje" placeholder="Mensaje" rows="4" required class="field-input resize-none"></textarea>
    </div>

    <div class="flex items-start gap-3">
      <input
        type="checkbox"
        id="form-privacidad"
        name="privacidad"
        required
        class="mt-1 size-4 shrink-0 accent-[#d7006b]"
      />
      <label for="form-privacidad" class="text-sm text-body">
        He leído y acepto la <a href={privacyHref} class="font-medium text-accent underline underline-offset-2">Política de privacidad</a>
      </label>
    </div>

    {
      showNeae && (
        <div class="flex items-start gap-3">
          <input
            type="checkbox"
            id="form-neae"
            name="neae_info"
            value="Sí"
            class="mt-1 size-4 shrink-0 accent-[#d7006b]"
          />
          <label for="form-neae" class="text-sm text-body">
            Quiero recibir información sobre las Becas NEAE
          </label>
        </div>
      )
    }

    <script is:inline>
      (function () {
        function checkNeae() {
          var checkbox = document.getElementById('form-neae');
          if (!checkbox) return;
          if (new URLSearchParams(window.location.search).has('neae')) {
            checkbox.checked = true;
            checkbox.setAttribute('checked', 'checked');
          } else {
            checkbox.checked = false;
            checkbox.removeAttribute('checked');
          }
        }
        checkNeae();
        document.addEventListener('astro:page-load', checkNeae);
      })();
    </script>

    <div>
      <button type="submit" class="btn-primary">Enviar</button>
    </div>

    <p class="form-status hidden rounded-md px-4 py-3 text-sm" role="status" aria-live="polite"></p>

    <div class="data-protection text-sm text-body">
      <details class="data-protection-details">
        <summary class="data-protection-trigger flex w-full cursor-pointer items-center gap-2 font-medium text-ink">
          <Icon name="info" class="size-4 text-accent" />
          <span class="flex-1">Información sobre protección de datos</span>
          <Icon name="chevron-down" class="data-protection-chevron size-4 transition-transform duration-300" />
        </summary>
        <div id="data-protection-panel" class="data-protection-panel" role="region" aria-label="Información sobre protección de datos">
          <div class="data-protection-content">
            <dl class="mt-3 flex flex-col gap-2 border-l-2 border-soft pl-4 text-[0.85rem] leading-relaxed">
              <div>
                <dt class="inline font-medium text-ink">Responsable: </dt>
                <dd class="inline">{isPending(site.rgpdOwner) ? 'Clínica LAUVEL (titularidad pendiente de confirmar)' : site.rgpdOwner}</dd>
              </div>
              <div><dt class="inline font-medium text-ink">Finalidad: </dt><dd class="inline">atender tu solicitud de información y ponernos en contacto contigo.</dd></div>
              <div><dt class="inline font-medium text-ink">Legitimación: </dt><dd class="inline">tu consentimiento al marcar la casilla de aceptación.</dd></div>
              <div><dt class="inline font-medium text-ink">Destinatarios: </dt><dd class="inline">no se cederán datos a terceros salvo obligación legal.</dd></div>
              <div>
                <dt class="inline font-medium text-ink">Derechos: </dt>
                <dd class="inline">puedes ejercer tus derechos de acceso, rectificación, supresión, oposición, limitación y portabilidad conforme a la <a href={privacyHref} class="text-accent underline underline-offset-2">Política de privacidad</a>.</dd>
              </div>
            </dl>
          </div>
        </div>
      </details>
    </div>
  </form>
</div>

<style>
  .field-input {
    width: 100%;
    border: 0;
    border-bottom: 1px solid rgb(22 22 21 / 0.15);
    background: transparent;
    padding: 0.7rem 0;
    color: var(--color-ink);
    transition: border-color 0.25s ease;
  }

  .field-input::placeholder {
    color: rgb(93 93 92 / 0.65);
  }

  .field-input:focus {
    border-color: var(--color-accent);
    outline: none;
  }

  .form-status.success {
    display: block;
    background: #ecfdf3;
    color: #067647;
  }

  .form-status.error {
    display: block;
    background: #fef0f4;
    color: #b42347;
  }

  .data-protection-details .data-protection-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .data-protection-details[open] .data-protection-panel {
    grid-template-rows: 1fr;
  }

  .data-protection-content {
    overflow: hidden;
    min-height: 0;
  }

  .data-protection-details[open] .data-protection-chevron {
    transform: rotate(180deg);
  }

  .data-protection-trigger::-webkit-details-marker {
    display: none;
  }
</style>

<script>
  const form = document.querySelector('[data-contact-form]');
  const status = form?.querySelector('.form-status');

  const showStatus = (type: 'success' | 'error', message: string) => {
    if (!status) return;
    status.classList.remove('hidden', 'success', 'error');
    status.classList.add(type);
    status.textContent = message;
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formEl = e.target as HTMLFormElement;

    if (formEl.getAttribute('data-has-key') !== 'true') {
      showStatus('error', 'El formulario está pendiente de configuración. Por favor, contacta con nosotros por teléfono.');
      return;
    }

    const submitBtn = formEl.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Enviando…';
    }

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: new FormData(formEl),
        headers: { Accept: 'application/json' },
      });
      const result = await response.json();
      if (result.success) {
        showStatus('success', 'Mensaje enviado correctamente. Nos pondremos en contacto contigo lo antes posible.');
        formEl.reset();
      } else {
        showStatus('error', 'No se ha podido enviar el mensaje. Inténtalo de nuevo o llámanos por teléfono.');
      }
    } catch {
      showStatus('error', 'No se ha podido enviar el mensaje. Revisa tu conexión e inténtalo de nuevo.');
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Enviar';
      }
    }
  });
</script>
