---
import TreatmentCard from './TreatmentCard.astro';
import type { Treatment } from '../../data/treatments';

interface Props {
  title: string;
  sideText: string;
  eyebrow?: string;
  treatments: Treatment[];
  class?: string;
}

const { title, sideText, eyebrow, treatments, class: className = '' } = Astro.props;
---

<section class:list={['py-20 md:py-28', className]}>
  <div class="container-site">
    <div class="reveal reveal--up mx-auto max-w-3xl text-center">
      {eyebrow && <p class="eyebrow mb-4">{eyebrow}</p>}
      <h2 class="text-[1.9rem] md:text-[2.6rem]">{title}</h2>
      <p class="mx-auto mt-5 max-w-2xl text-[1rem] text-body">{sideText}</p>
    </div>
  <div class="mt-14 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-treatment-grid>
    {treatments.map((treatment, i) => <TreatmentCard treatment={treatment} index={i} />)}
  </div>
</div>
</section>
