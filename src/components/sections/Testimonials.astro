---
import Icon from '../ui/Icon.astro';
import { testimonials } from '../../data/testimonials';
import { isPending } from '../../data/site';
---

<section class="overflow-hidden py-20 md:py-28">
  <div class="container-site">
    <div class="reveal reveal--up max-w-2xl">
      <p class="eyebrow mb-4">Testimonios</p>
      <h2 class="text-[1.9rem] md:text-[2.6rem]">Lo que nuestros pacientes destacan</h2>
    </div>

    <div class="relative mt-14">
      <div
        id="testimonials-track"
        class="flex snap-x snap-mandatory gap-6 overflow-x-auto pb-4 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
        tabindex="0"
        aria-label="Carrusel de reseñas de Google"
      >
        <div class="w-[7.5%] shrink-0 sm:w-[27%] lg:w-[34.25%]" aria-hidden="true"></div>
        {
          testimonials.map((t) => {
            const pending = isPending(t.author);
            return (
              <article class="relative w-[85%] shrink-0 snap-center rounded-xl border border-ink/5 bg-white p-7 shadow-card sm:w-[46%] lg:w-[31.5%]">
                <span class="pointer-events-none absolute top-5 right-6 font-display text-6xl leading-none text-accent/10 select-none" aria-hidden="true">&rdquo;</span>
                <div class="flex items-center gap-3">
                  <span class="flex size-11 items-center justify-center rounded-full bg-accent font-display text-lg font-semibold text-white" aria-hidden="true">
                    {pending ? <Icon name="logopedia" class="size-5" /> : t.author.charAt(0)}
                  </span>
                  <div>
                    <p class="text-[0.95rem] font-medium text-ink">{pending ? 'Reseña de Google' : t.author}</p>
                    <p class="text-xs text-body">{t.date}</p>
                  </div>
                  <Icon name="google" class="ml-auto size-5 text-ink/70" />
                </div>
                <div class="mt-3 flex gap-0.5 text-[#fbbc04]" aria-label={`${t.rating} de 5 estrellas`}>
                  {Array.from({ length: t.rating }).map(() => (
                    <Icon name="star" class="size-4" filled />
                  ))}
                </div>
                <p class="mt-3 text-[0.95rem] text-body">{t.text}</p>
              </article>
            );
          })
        }
        <div class="w-[7.5%] shrink-0 sm:w-[27%] lg:w-[34.25%]" aria-hidden="true"></div>
      </div>

      <button
        type="button"
        id="testimonials-prev"
        class="absolute top-[calc(50%-0.5rem)] -left-5 hidden size-12 -translate-y-1/2 items-center justify-center rounded-full border border-accent/50 bg-white text-accent shadow-md transition-colors hover:bg-accent hover:text-white md:inline-flex"
        aria-label="Reseñas anteriores"
      >
        <Icon name="arrow-right" class="size-5 rotate-180" />
      </button>
      <button
        type="button"
        id="testimonials-next"
        class="absolute top-[calc(50%-0.5rem)] -right-5 hidden size-12 -translate-y-1/2 items-center justify-center rounded-full border border-accent/50 bg-white text-accent shadow-md transition-colors hover:bg-accent hover:text-white md:inline-flex"
        aria-label="Reseñas siguientes"
      >
        <Icon name="arrow-right" class="size-5" />
      </button>
    </div>
  </div>
</section>

<script>
  const track = document.getElementById('testimonials-track');
  const cards = track ? Array.from(track.querySelectorAll('article')) : [];

  const centerCard = (card: Element) => {
    if (!track) return;
    const trackRect = track.getBoundingClientRect();
    const cardRect = card.getBoundingClientRect();
    const delta = cardRect.left + cardRect.width / 2 - (trackRect.left + trackRect.width / 2);
    track.scrollBy({ left: delta, behavior: 'smooth' });
  };

  const currentIndex = () => {
    if (!track || cards.length === 0) return 0;
    const trackRect = track.getBoundingClientRect();
    const mid = trackRect.left + trackRect.width / 2;
    let best = 0;
    let bestDist = Infinity;
    cards.forEach((card, i) => {
      const r = card.getBoundingClientRect();
      const d = Math.abs(r.left + r.width / 2 - mid);
      if (d < bestDist) {
        bestDist = d;
        best = i;
      }
    });
    return best;
  };

  document.getElementById('testimonials-prev')?.addEventListener('click', () => {
    const i = currentIndex();
    if (i > 0) centerCard(cards[i - 1]);
  });
  document.getElementById('testimonials-next')?.addEventListener('click', () => {
    const i = currentIndex();
    if (i < cards.length - 1) centerCard(cards[i + 1]);
  });

  const centerFirst = () => {
    if (!track || cards.length === 0) return;
    const trackRect = track.getBoundingClientRect();
    const cardRect = cards[0].getBoundingClientRect();
    const delta = cardRect.left + cardRect.width / 2 - (trackRect.left + trackRect.width / 2);
    track.scrollTo({ left: track.scrollLeft + delta, behavior: 'instant' as ScrollBehavior });
  };
  centerFirst();
  window.addEventListener('resize', centerFirst);
</script>
