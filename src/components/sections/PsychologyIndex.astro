---
import ArrowButton from '../ui/ArrowButton.astro';

interface Props {
  eyebrow: string;
  title: string;
  cards: { label: string; description: string; href: string }[];
}

const { eyebrow, title, cards } = Astro.props;
---

<section class="py-16 md:py-20">
  <div class="container-site">
    <div class="reveal reveal--up mx-auto max-w-3xl text-center">
      <p class="eyebrow mb-4">{eyebrow}</p>
      <h2 class="text-[1.9rem] md:text-[2.6rem]">{title}</h2>
    </div>
    <div class="mt-12 grid gap-6 sm:grid-cols-2">
      {
        cards.map((card) => (
          <article class="reveal reveal--up flex items-center gap-5 rounded-xl border border-ink/5 bg-white p-6 shadow-card md:p-8">
            <div class="flex-1">
              <h3 class="font-display text-[1.32rem] leading-snug font-medium text-ink">{card.label}</h3>
              <p class="mt-2 text-[0.95rem] text-body">{card.description}</p>
            </div>
            <ArrowButton href={card.href} label={`Ir a ${card.label}`} icon="arrow-down" />
          </article>
        ))
      }
    </div>
  </div>
</section>
