---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { withBase } from '../../utils/url';

interface Props {
  title: string;
  image: ImageMetadata;
  imageAlt: string;
  cta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  large?: boolean;
  compact?: boolean;
  imageWide?: ImageMetadata;
  imageWide2x?: ImageMetadata;
  imagePosition?: string;
}

const {
  title,
  image,
  imageAlt,
  cta,
  secondaryCta,
  large = false,
  compact = false,
  imageWide,
  imageWide2x,
  imagePosition = 'center',
} = Astro.props;
const resolveHref = (href: string) => (href.startsWith('/') ? withBase(href) : href);
const ctaHref = cta ? resolveHref(cta.href) : undefined;
const secondaryHref = secondaryCta ? resolveHref(secondaryCta.href) : undefined;

const wideWidths = [1024, 1280, 1536];
const wide2xWidths = [1920, 2560];
const wideEntries = imageWide
  ? await Promise.all(wideWidths.map((width) => getImage({ src: imageWide, width, format: 'webp', quality: 85 })))
  : [];
const wide2xEntries = imageWide2x
  ? await Promise.all(wide2xWidths.map((width) => getImage({ src: imageWide2x, width, format: 'webp', quality: 85 })))
  : [];
const wideSrcset = imageWide
  ? [
      ...wideEntries.map((img, i) => `${img.src} ${wideWidths[i]}w`),
      ...wide2xEntries.map((img, i) => `${img.src} ${wide2xWidths[i]}w`),
    ].join(', ')
  : undefined;
---

<section
  class:list={[
    'relative flex items-center overflow-hidden',
    large ? 'min-h-[88svh]' : compact ? 'min-h-[46svh] md:min-h-[68svh]' : 'min-h-[68svh]',
  ]}
>
  <picture>
    {wideSrcset && <source media="(min-width: 768px)" srcset={wideSrcset} sizes="100vw" type="image/webp" />}
    <Image
      src={image}
      alt={imageAlt}
      widths={[768, 1024, 1280, 1600]}
      sizes="100vw"
      class="absolute inset-0 h-full w-full object-cover"
      style={`object-position: ${imagePosition}`}
      loading="eager"
      fetchpriority="high"
    />
  </picture>
  <div class="hero-overlay absolute inset-0" aria-hidden="true"></div>
  <div class:list={['container-site relative z-10', compact ? 'pt-32 pb-10 md:pt-36 md:pb-20' : 'pt-36 pb-20']}>
    <h1
      class:list={[
        'max-w-4xl font-display font-medium text-white',
        large ? 'text-[2.5rem] md:text-6xl lg:text-[4.35rem]' : 'text-[2.35rem] md:text-5xl lg:text-[3.9rem]',
      ]}
    >
      {title}
    </h1>
    {
      (cta || secondaryCta) && (
        <div class:list={['flex flex-wrap gap-3', compact ? 'mt-6 md:mt-9' : 'mt-9']}>
          {cta && <a href={ctaHref} class="btn-primary">{cta.label}</a>}
          {secondaryCta && (
            <a
              href={secondaryHref}
              class="inline-flex items-center justify-center gap-2 rounded-md border border-white/80 px-8 py-3.5 font-sans text-base font-medium text-white transition-colors duration-300 hover:bg-white hover:text-ink"
            >
              {secondaryCta.label}
            </a>
          )}
        </div>
      )
    }
  </div>
</section>
