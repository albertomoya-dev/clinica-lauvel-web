    <g>
      <path d="M12 21.5s-7.5-6-7.5-11.3a7.5 7.5 0 1 1 15 0C19.5 15.5 12 21.5 12 21.5Z" />
      <circle cx="12" cy="10" r="2.6" />
    </g>
  )}
  {name === 'logopedia' && (
    <g>
      <path d="M21 11.5a8.5 8.5 0 0 1-12.4 7.5L3 20l1.1-4.4A8.5 8.5 0 1 1 21 11.5Z" />
      <path d="M8 10h8M8 13.5h5" />
    </g>
  )}
  {name === 'psicologia' && (
    <g>
      <path d="M12 3a7 7 0 0 0-7 7c0 2 .8 3.3 1.6 4.4.7 1 1.4 2 1.4 3.1V19a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2v-1.5c0-1.1.7-2.1 1.4-3.1.8-1.1 1.6-2.4 1.6-4.4a7 7 0 0 0-7-7Z" />
      <path d="M9.5 10.5h5M12 8v5" />
    </g>
  )}
  {name === 'pedagogia' && (
    <g>
      <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5Z" />
      <path d="M4 20.5V5.5" />
      <path d="M9 8h7M9 11.5h5" />
    </g>
  )}
  {name === 'fisioterapia' && (
    <g>
      <circle cx="13.5" cy="4.3" r="2" />
      <path d="m10.5 8.5 3.5 1 3-2M10.5 8.5 8 12l-2.5 1.5M10.5 8.5l-1 4.5L7 15.5 5 20M9.5 13l3 2.5L13 21" />
    </g>
  )}
  {name === 'motricidad' && (
    <g>
      <circle cx="12" cy="12" r="9" />
      <path d="M8.5 14s1.4 2 3.5 2 3.5-2 3.5-2" />
      <path d="M9 9.3h.01M15 9.3h.01" />
