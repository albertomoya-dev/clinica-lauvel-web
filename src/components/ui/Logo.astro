---
import { Image } from 'astro:assets';
import { withBase } from '../../utils/url';
import logoIcon from '../../assets/images/logo-icon.png';
import logoMain from '../../assets/images/logo-main.png';

interface Props {
  type?: 'icon' | 'main';
  class?: string;
}

const { type = 'icon', class: className = '' } = Astro.props;
const image = type === 'main' ? logoMain : logoIcon;
const alt = type === 'main' ? 'Clínica LAUVEL' : 'Clínica LAUVEL — Icono';
---

<a href={withBase('/')} class:list={['inline-flex items-center', className]} aria-label="Clínica LAUVEL — Inicio">
  <Image
    src={image}
    alt={alt}
    width={type === 'main' ? 256 : 128}
    height={type === 'main' ? 256 : 128}
    class="h-full w-auto rounded-full object-contain"
    loading="eager"
    decoding="async"
  />
</a>
