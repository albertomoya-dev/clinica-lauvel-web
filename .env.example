PUBLIC_SITE_URL=https://www.clinicalauvel.es
PUBLIC_WEB3FORMS_KEY=

# Datos de contacto (aparecen en footer, página de contacto y políticas)
PUBLIC_CONTACT_EMAIL=
PUBLIC_CONTACT_PHONE=
# Opcional: formato "tel:+34123456789". Si no se indica, se genera automáticamente desde PUBLIC_CONTACT_PHONE.
PUBLIC_CONTACT_PHONE_HREF=
# Número para WhatsApp (sin espacios ni +, ej: 34123456789)
PUBLIC_CONTACT_WHATSAPP=

# Reseñas de Google (Places API New). Sin PUBLIC_: solo se usan en build/CI.
# Si GOOGLE_PLACE_ID falta, el script lo resuelve buscando la ficha por dirección.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
